HOST=127.0.0.1
PORT=3000
# The scan provider endpoint. The default points at the bundled fake provider
# (npm run fake-upstream); replace both values for a provider you are authorised to poll.
API_URL=http://127.0.0.1:4010/api/scan
API_TOKEN=demo-token
# Choose the beginning of your permitted event window.
EVENT_START_DATE=2026-02-04T08:00:00.000Z
POLL_INTERVAL_CRON=*/5 * * * *
DB_PATH=./data/booth-scans.db
LOG_LEVEL=info
