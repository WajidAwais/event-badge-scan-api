{
  "name": "booth-scan-tracking-service",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch --env-file=.env index.ts",
    "fake-upstream": "node dist/src/fake-upstream/main.js",
    "dev:fake-upstream": "tsx src/fake-upstream/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "axios": "^1.21.0",
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.14.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
